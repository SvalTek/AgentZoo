# AgentZoo's runtime base is deliberately separate from user WSL distributions.
# One privileged runtime container hosts many agent OverlayFS/chroot roots.
FROM ghcr.io/astral-sh/uv:latest AS uv

FROM debian:bookworm-slim

ENV TZ=Etc/UTC

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        bindfs \
        build-essential \
        ca-certificates \
        coreutils \
        curl \
        file \
        findutils \
        fuse3 \
        fuse-overlayfs \
        git \
        grep \
        iproute2 \
        iputils-ping \
        less \
        lsof \
        p7zip-full \
        pciutils \
        procps \
        proot \
        psmisc \
        python3 \
        python3-pip \
        python3-venv \
        tini \
        tmux \
        tzdata \
        unzip \
        util-linux \
        wget \
        xz-utils \
        zip \
    && rm -rf /var/lib/apt/lists/* \
    && ln -snf "/usr/share/zoneinfo/${TZ}" /etc/localtime \
    && echo "${TZ}" > /etc/timezone \
    && printf '%s\n' 'source ~/.bashrc' > /root/.bash_profile \
    && printf '%s\n' 'export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin' 'export PS1="\\u@localhost:\\w\\$ "' > /root/.bashrc \
    && mkdir -p /opt/runtime/rootfs-template \
    && cp -a /bin /etc /home /lib /lib64 /root /sbin /usr /var /opt/runtime/rootfs-template/ \
    && mkdir -p /opt/runtime/rootfs-template/dev /opt/runtime/rootfs-template/proc /opt/runtime/rootfs-template/run /opt/runtime/rootfs-template/shared /opt/runtime/rootfs-template/tmp \
    && chmod 1777 /opt/runtime/rootfs-template/tmp

# These are broadly useful, lightweight language/package tools for arbitrary work.
RUN curl -fsSL https://deno.land/install.sh | DENO_INSTALL=/usr/local sh \
    && deno --version
COPY --from=uv /uv /uvx /usr/local/bin/

COPY runtime-entrypoint.sh /usr/local/bin/runtime-host
RUN chmod 0755 /usr/local/bin/runtime-host

ENTRYPOINT ["/usr/local/bin/runtime-host"]
CMD ["sleep", "infinity"]
